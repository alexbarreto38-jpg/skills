# VideoDNA Studio — variáveis de ambiente.
#
# Copie para `apps/api/.env` (API e worker leem o .env do diretório onde rodam)
# ou exporte no shell. O docker-compose.yml já define valores de desenvolvimento;
# um `.env` na raiz só é usado por ele para sobrescrever as variáveis ${...}.
#
# NUNCA coloque segredos reais neste arquivo nem em qualquer arquivo versionado.
# O frontend não recebe nenhuma chave: só NEXT_PUBLIC_API_URL (ver apps/web/.env.example).

# --- runtime ------------------------------------------------------------------
APP_ENV=development                 # development | test | production
API_BASE_URL=http://localhost:8000  # usada para montar URLs assinadas do storage local
CORS_ORIGINS=http://localhost:3000  # lista separada por vírgula (ou JSON)
LOG_LEVEL=INFO
LOG_JSON=false                      # true em produção/containers

# --- banco / fila ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://videodna:videodna@localhost:5432/videodna
# Sem Postgres: DATABASE_URL=sqlite:///./var/videodna.db
REDIS_URL=redis://localhost:6379/0
# dramatiq: workers reais (Redis) · thread: jobs numa thread da API (dev sem Redis)
# inline: síncrono (testes)
QUEUE_BACKEND=dramatiq

# --- storage --------------------------------------------------------------------
STORAGE_BACKEND=local               # local | s3 (AWS S3, Cloudflare R2, MinIO)
STORAGE_LOCAL_ROOT=./var/storage
WORK_DIR=./var/work                 # arquivos temporários do FFmpeg
# S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # host que o navegador enxerga
# S3_REGION=us-east-1
# S3_BUCKET=videodna
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SEC=3600

# --- segurança --------------------------------------------------------------------
# Em produção a API se recusa a subir com os valores padrão ou com autologin ligado.
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# SIGNING_SECRET=
JWT_TTL_MINUTES=1440
AUTH_DEV_AUTOLOGIN=true             # requisições sem token viram o usuário dev
DEV_USER_EMAIL=dev@videodna.local
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=12

# --- AI Orchestrator -----------------------------------------------------------------
AI_MOCK_MODE=true                   # true: só providers mock/locais, nenhum crédito gasto
PROVIDERS_CONFIG_PATH=./config/providers.yaml
FEATURES_CONFIG_PATH=./config/features.yaml
# Sobrescreve flags: "smart_mode=true,provider.mock-edit-lite=false"
FEATURE_FLAGS=
# Injeta falhas em providers mock (teste de fallback): "mock-edit-pro:error,mock-v2v:timeout"
MOCK_PROVIDER_FAILURES=
PROVIDER_TIMEOUT_SEC=600
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_BACKOFF_BASE_SEC=0.5
# Credenciais de providers reais: declare o NOME da variável em `credentials_env`
# no providers.yaml e defina o valor só no ambiente do servidor, por exemplo:
# ACME_VIDEO_API_KEY=

# --- upload / validação de mídia -------------------------------------------------------
UPLOAD_MAX_BYTES=2147483648
UPLOAD_PART_SIZE=16777216
VIDEO_MAX_DURATION_SEC=600
VIDEO_MIN_DURATION_SEC=0.5
# UPLOAD_ALLOWED_CONTENT_TYPES=video/mp4,video/quicktime,video/webm,video/x-matroska,video/x-msvideo
# VIDEO_ALLOWED_CODECS=h264,hevc,vp8,vp9,av1,mpeg4,prores
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_TIMEOUT_SEC=1800

# --- análise ----------------------------------------------------------------------
ANALYSIS_LOW_CONFIDENCE_THRESHOLD=0.6
ANALYSIS_MAX_KEYFRAMES=120
ANALYSIS_KEYFRAME_INTERVAL_SEC=4
SHOT_DETECTION_THRESHOLD=0.30
SHOT_MIN_DURATION_SEC=0.4
PROXY_HEIGHT=720
FINAL_HEIGHT=1080

# --- geração -------------------------------------------------------------------------
GENERATION_MAX_RETRIES_ECONOMY=1
GENERATION_MAX_RETRIES_BALANCED=2
GENERATION_MAX_RETRIES_MAX=3
QA_REPAIR_MIN_SEVERITY=MEDIUM       # LOW | MEDIUM | HIGH | CRITICAL
COST_CURRENCY=BRL
# Câmbio que VOCÊ define para converter preços de providers: "USD:5.40,EUR:6.10"
FX_RATES_TO_BASE=
COST_OVERRUN_TOLERANCE=0.25         # aborta se o custo real passar 25% do orçamento
FALLBACK_MAX_COST_INCREASE=0.5      # fallback não pode custar >50% a mais

# --- privacidade / retenção --------------------------------------------------------------
MEDIA_RETENTION_DAYS=30             # vazio = sem expiração automática

# --- observabilidade (opcional) ----------------------------------------------------------
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
