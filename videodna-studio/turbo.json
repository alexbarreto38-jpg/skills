{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "DATABASE_URL",
        "QUEUE_BACKEND",
        "STORAGE_BACKEND",
        "REDIS_URL",
        "AI_MOCK_MODE"
      ]
    },
    "generate": {
      "inputs": [
        "openapi.json"
      ],
      "outputs": [
        "src/schema.d.ts"
      ]
    }
  }
}
